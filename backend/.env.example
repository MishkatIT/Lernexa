# Copy to .env and fill in. Generate every secret fresh:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS wants at least two comma-separated values.

# Server
HOST=0.0.0.0
PORT=1337
# Public URL of the deployed API (Railway sets this). Leave blank locally.
PUBLIC_URL=
# Set true behind a TLS-terminating proxy (Railway). false locally.
IS_PROXIED=false

# CORS — comma-separated list of allowed browser origins.
# Local: http://localhost:3000  |  Prod: add your Vercel URL.
CORS_ORIGINS=http://localhost:3000

# Secrets — DO NOT reuse the values Strapi prints in dev.
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database — Postgres.
#   Railway: add a Postgres service, then set DATABASE_URL to the reference
#            ${{Postgres.DATABASE_URL}} and DATABASE_SSL=true.
#   Local:   leave DATABASE_URL blank and use the discrete DATABASE_* vars.
# When DATABASE_URL is set it wins; the discrete vars are ignored.
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Abuse control — src/middlewares/rate-limit.ts caps write requests per IP
# (auth endpoints are separately limited by users-permissions). Set
# RATE_LIMIT_ENABLED=false when running the test suite locally.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
