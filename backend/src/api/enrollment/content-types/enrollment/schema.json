{
  "kind": "collectionType",
  "collectionName": "enrollments",
  "info": {
    "singularName": "enrollment",
    "pluralName": "enrollments",
    "displayName": "Enrollment",
    "description": "One student in one course. Unique on (student, course) — DB index added in Phase 4."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "enrollments",
      "required": true
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "enrollments",
      "required": true
    },
    "enrolledAt": {
      "type": "datetime"
    },
    "dedupeKey": {
      "type": "string",
      "unique": true,
      "private": true,
      "configurable": false
    }
  }
}
