# Copy to .env.local and fill in.

# Base URL of the Strapi API. SERVER-ONLY — never prefix with NEXT_PUBLIC_.
# Nothing in the browser needs to know where Strapi lives under this architecture.
# Local:  http://localhost:1337
# Prod:   your Railway URL
STRAPI_URL=http://localhost:1337

# Name of the httpOnly session cookie that carries the Strapi JWT.
SESSION_COOKIE_NAME=lms_session
